# Copie para .env (nunca commitar). No GitHub, os mesmos nomes vão em
# Settings → Secrets and variables → Actions.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# DataForSEO → app.dataforseo.com → API Access (login + senha da API, não a do site)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Opcionais
# USEO_COST_ALERT_USD=5      # alerta (job falha) se o custo do dia passar disso
# USEO_SERP_DEPTH=100        # quantos resultados buscar por SERP
# USEO_SERP_TIMEOUT_MIN=45   # quanto esperar a fila da DataForSEO
